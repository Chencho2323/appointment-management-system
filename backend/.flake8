[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    venv,
    env,
    .venv,
    migrations,
    .pytest_cache
# Flake8 no admite comentarios dentro de una lista: el valor debe ser una
# lista de codigos separada por comas. E203 (espacio antes de ':') y W503
# (salto de linea antes de operador binario) son incompatibles con Black.
ignore = E203,W503
per-file-ignores =
    __init__.py:F401
